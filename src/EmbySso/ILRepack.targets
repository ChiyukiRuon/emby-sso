<Project>
    <Target Name="PackagePlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <ItemGroup>
            <MergeAssemblies Include="$(TargetPath)" />
            <MergeAssemblies Include="$(TargetDir)Microsoft.IdentityModel.*.dll" />
            <MergeAssemblies Include="$(TargetDir)Microsoft.Extensions.*.dll" />
            <MergeSearchPaths Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
        </ItemGroup>
        <MakeDir Directories="$(MSBuildProjectDirectory)/../../artifacts" />
        <ILRepack InputAssemblies="@(MergeAssemblies)" Internalize="true" TargetKind="Dll"
            LibraryPath="@(MergeSearchPaths)" DebugInfo="false"
            OutputFile="$(MSBuildProjectDirectory)/../../artifacts/EmbySso.dll" />
    </Target>
</Project>
