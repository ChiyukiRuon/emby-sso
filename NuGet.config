<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- scripts/fetch-packages.py populates this local feed for offline builds. -->
    <add key="local" value=".cache/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
